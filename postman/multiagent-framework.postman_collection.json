    {
      "name": "Pattern Smoke Tests (requires ANTHROPIC_API_KEY)",
      "item": [
        {
          "name": "Sequential — 2-step pipeline",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('has_api_key') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Run succeeded', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "});",
                  "pm.test('final_output var is populated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.vars.final_output).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Token usage recorded', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.tokenUsage.input).to.be.above(0);",
                  "  pm.expect(body.tokenUsage.output).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/run",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sequential Smoke\",\n  \"pattern\": \"sequential\",\n  \"goal\": \"Write a one-sentence summary of what photosynthesis is.\",\n  \"agents\": [\n    { \"id\": \"writer\",  \"prompt\": \"You are a science writer. Answer the question in one concise sentence.\" },\n    { \"id\": \"checker\", \"prompt\": \"You are a copy editor. Confirm the text is accurate and return it unchanged or improved.\" }\n  ],\n  \"workflow\": {\n    \"steps\": [\n      { \"agent\": \"writer\",  \"input\": \"{{goal}}\",     \"output\": \"draft\" },\n      { \"agent\": \"checker\", \"input\": \"{{draft}}\",     \"output\": \"final_output\" }\n    ]\n  }\n}"
            }
          }
        },
        {
          "name": "Parallel — 2 perspectives + aggregator",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('has_api_key') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Parallel run succeeded', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.vars.final_output).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/run",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Parallel Smoke\",\n  \"pattern\": \"parallel\",\n  \"goal\": \"What are the pros and cons of remote work?\",\n  \"agents\": [\n    { \"id\": \"pro_analyst\",  \"prompt\": \"List 2 key advantages of remote work in bullet points.\" },\n    { \"id\": \"con_analyst\",  \"prompt\": \"List 2 key disadvantages of remote work in bullet points.\" },\n    { \"id\": \"synthesizer\",  \"prompt\": \"Combine the pros and cons into a balanced 2-sentence summary.\" }\n  ],\n  \"parallel\": {\n    \"agents\": [\"pro_analyst\", \"con_analyst\"],\n    \"input\": \"{{goal}}\",\n    \"aggregator\": \"synthesizer\",\n    \"output\": \"final_output\"\n  }\n}"
            }
          }
        },
        {
          "name": "Sequential — with output validation (rule)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('has_api_key') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Output contains YES or NO', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  const out = body.vars.final_output;",
                  "  pm.expect(out.includes('YES') || out.includes('NO')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/run",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Validation Smoke\",\n  \"pattern\": \"sequential\",\n  \"goal\": \"Is water a liquid at room temperature?\",\n  \"agents\": [\n    {\n      \"id\": \"classifier\",\n      \"prompt\": \"Answer the question with exactly YES or NO followed by a brief explanation.\",\n      \"validate\": {\n        \"type\": \"rule\",\n        \"rule\": \"output.includes('YES') || output.includes('NO')\",\n        \"maxRetries\": 2,\n        \"onFail\": \"warn\"\n      }\n    }\n  ],\n  \"workflow\": {\n    \"steps\": [\n      { \"agent\": \"classifier\", \"input\": \"{{goal}}\", \"output\": \"final_output\" }\n    ]\n  }\n}"
            }
          }
        },
        {
          "name": "Sequential — vars interpolation in steps",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('has_api_key') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Pre-seeded var used in output', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.vars.final_output).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/run",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vars Interpolation Smoke\",\n  \"pattern\": \"sequential\",\n  \"goal\": \"Write a greeting.\",\n  \"vars\": { \"userName\": \"Alice\", \"lang\": \"Spanish\" },\n  \"agents\": [\n    { \"id\": \"greeter\", \"prompt\": \"Write a short greeting in the requested language.\" }\n  ],\n  \"workflow\": {\n    \"steps\": [\n      { \"agent\": \"greeter\", \"input\": \"Write a greeting in {{lang}} for {{userName}}.\", \"output\": \"final_output\" }\n    ]\n  }\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Router Pattern",
      "item": [
        {
          "name": "Router — schema validation with all route types",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/validate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Full Router Validate\",\n  \"pattern\": \"router\",\n  \"goal\": \"Test query\",\n  \"agents\": [\n    { \"id\": \"clf\",  \"prompt\": \"Classifier\" },\n    { \"id\": \"a1\",   \"prompt\": \"Agent 1\" },\n    { \"id\": \"a2\",   \"prompt\": \"Agent 2\" },\n    { \"id\": \"a3\",   \"prompt\": \"Supervisor\" },\n    { \"id\": \"w1\",   \"prompt\": \"Worker\" },\n    { \"id\": \"agg\",  \"prompt\": \"Aggregator\" },\n    { \"id\": \"def\",  \"prompt\": \"Default agent\" }\n  ],\n  \"routerConfig\": {\n    \"classifier\": \"clf\",\n    \"input\": \"Classify: {{goal}}\",\n    \"routeVar\": \"route\",\n    \"output\": \"final_output\",\n    \"tokenBudget\": 50000,\n    \"routes\": {\n      \"sequential_route\": {\n        \"pattern\": \"sequential\",\n        \"workflow\": { \"steps\": [{ \"agent\": \"a1\", \"input\": \"{{goal}}\", \"output\": \"final_output\" }] }\n      },\n      \"parallel_route\": {\n        \"pattern\": \"parallel\",\n        \"parallel\": { \"agents\": [\"a1\", \"a2\"], \"input\": \"{{goal}}\", \"aggregator\": \"agg\", \"output\": \"final_output\" }\n      },\n      \"supervisor_route\": {\n        \"pattern\": \"supervisor\",\n        \"supervisorConfig\": { \"supervisor\": \"a3\", \"workers\": [\"w1\"], \"input\": \"{{goal}}\", \"maxTurns\": 4 }\n      }\n    },\n    \"default\": {\n      \"pattern\": \"sequential\",\n      \"workflow\": { \"steps\": [{ \"agent\": \"def\", \"input\": \"{{goal}}\", \"output\": \"final_output\" }] }\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Full router config valid', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.valid).to.be.true;",
                  "  pm.expect(body.pattern).to.equal('router');",
                  "  pm.expect(body.agentCount).to.equal(7);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Router — smoke test with LLM classifier",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (pm.collectionVariables.get('has_api_key') !== 'true') {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Router dispatched successfully', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "});",
                  "pm.test('Route key stored in vars', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.vars.route).to.be.a('string').and.not.empty;",
                  "  pm.expect(['science', 'general']).to.include(body.vars.route);",
                  "});",
                  "pm.test('final_output populated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.vars.final_output).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/run",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Router Smoke\",\n  \"pattern\": \"router\",\n  \"goal\": \"Explain how black holes form.\",\n  \"agents\": [\n    {\n      \"id\": \"clf\",\n      \"prompt\": \"Classify the query into exactly one of: science, general. Output only the category name, lowercase.\"\n    },\n    { \"id\": \"science_agent\", \"prompt\": \"You are a science communicator. Answer clearly and accurately.\" },\n    { \"id\": \"general_agent\", \"prompt\": \"You are a helpful assistant. Answer the question.\" }\n  ],\n  \"routerConfig\": {\n    \"classifier\": \"clf\",\n    \"input\": \"{{goal}}\",\n    \"routeVar\": \"route\",\n    \"output\": \"final_output\",\n    \"routes\": {\n      \"science\": {\n        \"pattern\": \"sequential\",\n        \"workflow\": { \"steps\": [{ \"agent\": \"science_agent\", \"input\": \"{{goal}}\", \"output\": \"final_output\" }] }\n      }\n    },\n    \"default\": {\n      \"pattern\": \"sequential\",\n      \"workflow\": { \"steps\": [{ \"agent\": \"general_agent\", \"input\": \"{{goal}}\", \"output\": \"final_output\" }] }\n    }\n  }\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Error Handling",
      "item": [
        {
          "name": "Run — no API key (503)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/run",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"N/A\",\n  \"pattern\": \"sequential\",\n  \"goal\": \"Test\",\n  \"agents\": [{ \"id\": \"a\", \"prompt\": \"P\" }],\n  \"workflow\": { \"steps\": [{ \"agent\": \"a\", \"input\": \"{{goal}}\", \"output\": \"out\" }] }\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Only meaningful when API key is absent; skip when key is present",
                  "if (pm.collectionVariables.get('has_api_key') === 'true') {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('503 when API key missing', () => {",
                  "  pm.response.to.have.status(503);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.include('ANTHROPIC_API_KEY');",
                  "});"
                ]
              }
            }
          ]
